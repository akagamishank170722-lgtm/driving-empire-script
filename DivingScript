-- [[ LOGIC & FUNCTIONS ]] --

-- Fungsi Copy Link Group
JoinBtn.MouseButton1Click:Connect(function()
    setclipboard(GROUP_URL)
    
    StarterGui:SetCore("SendNotification", {
        Title = "Link Tersalin!",
        Text = "Link grup telah disalin ke clipboard Anda.",
        Duration = 3
    })
end)

-- Fungsi Eksekusi Script Utama
local function loadMainScript()
    VerifyBtn.Text = "Loading Script..."
    task.wait(1)
    
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.5), {Size = UDim2.new(0, 0, 0, 0)})
    tween:Play()
    tween.Completed:Wait()
    ScreenGui:Destroy()
    
    loadstring(game:HttpGet(SCRIPT_URL))()
end

-- Fungsi Verifikasi Status Member
VerifyBtn.MouseButton1Click:Connect(function()
    if not GROUP_ID then
        VerifyBtn.Text = "URL Grup Tidak Valid!"
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        return
    end

    VerifyBtn.Text = "Checking..."
    task.wait(0.5)
    
    local success, isInGroup = pcall(function()
        return LocalPlayer:IsInGroup(GROUP_ID)
    end)
    
    if success and isInGroup then
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
        VerifyBtn.Text = "Verified! Loading..."
        loadMainScript()
    else
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        VerifyBtn.Text = "Belum Join! Coba Lagi"
        
        StarterGui:SetCore("SendNotification", {
            Title = "Verifikasi Gagal",
            Text = "Anda belum bergabung ke dalam grup!",
            Duration = 3
        })
        
        task.wait(2)
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
        VerifyBtn.Text = "✓ Verify & Execute"
    end
end)
