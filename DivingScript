-- Masukkan URL Grup Roblox kamu di bawah ini (Format link bebas, ID akan terdeteksi otomatis):
local GROUP_URL = "https://roblox.com.ge/communities/8692078709/"
local SCRIPT_URL = "https://rawscripts.net/raw/VOLVO-Driving-Empire-Car-RacingRP-Axonic-Keyless-244038"

-- [[ AUTO-EXTRACT GROUP ID ]] --
local function extractGroupId(url)
    local groupId = url:match("/groups/(%d+)") or url:match("(%d+)")
    return tonumber(groupId)
end

local GROUP_ID = extractGroupId(GROUP_URL)

